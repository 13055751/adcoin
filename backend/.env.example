# 复制为 .env 并按需修改
# ---- 后端自身 ----
PORT=8787
DB_FILE=./data/users.json

# ---- 插件连接（与插件 config.yml 一致）----
PLUGIN_BASE_URL=http://127.0.0.1:17890
PLUGIN_API_KEY=CHANGE-ME-PLEASE-USE-A-LONG-RANDOM-SECRET-STRING

# ---- 广告验证模式 ----
# mock   = 模拟广告，看广告直接发币（联调用，默认）
# admob  = 真实 AdMob（需配置 ADMOB_*，见 docs）
# pangle = 真实 Pangle（需配置 PANGLE_*，见 docs）
AD_MODE=mock
# 单次广告奖励金额（后端决定发多少）
AD_REWARD_AMOUNT=50

# ---- AdMob SSV（真实模式）----
# AdMob 后台配置的 SSV 回调 URL: http://<你的公网>/ssv/admob
ADMOB_SSV_SECRET=CHANGE-ME-ADMOB-SSV-SECRET

# ---- Pangle（真实模式）----
PANGLE_APP_ID=
PANGLE_SDK_SECRET=
